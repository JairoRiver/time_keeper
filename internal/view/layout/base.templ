package layout

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — TimeKeeper</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link
				href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap"
				rel="stylesheet"
			/>
			<link rel="stylesheet" href={ "/static/css/output.css?v=" + cssVersion() }/>
		</head>
		<body class="min-h-screen bg-slate-50 font-sans text-slate-800 antialiased">
			{ children... }
		</body>
	</html>
}
