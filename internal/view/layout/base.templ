package layout

templ Base(title string) {
    <!DOCTYPE html>
    <html lang="es">
        <head>
            <meta charset="UTF-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <title>{ title } — TimeKeeper</title>
            <link rel="stylesheet" href="/static/css/output.css"/>
        </head>
        <body class="bg-gray-50 min-h-screen">
            { children... }
        </body>
    </html>
}