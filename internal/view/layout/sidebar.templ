package layout

templ Sidebar(activePage string) {
	<aside class="hidden md:flex w-60 shrink-0 flex-col gap-1 border-r border-slate-200 bg-white p-4">
		@navItem("/registro", "Registro de tiempo", activePage == "registro") {
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"></path></svg>
		}
		@navItem("/resumen", "Resumen", activePage == "resumen") {
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M8 2v4m8-4v4"></path></svg>
		}
	</aside>
}

templ navItem(href string, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={
			"flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-colors",
			templ.KV("bg-indigo-50 text-indigo-700", active),
			templ.KV("text-slate-600 hover:bg-slate-100 hover:text-slate-900", !active),
		}
	>
		{ children... }
		{ label }
	</a>
}
