package layout

templ App(title string, activePage string, authenticated bool, isAnonymous bool) {
	@Base(title) {
		<div class="flex flex-col min-h-screen">
			@Header(authenticated, isAnonymous)
			<div class="flex flex-1">
				@Sidebar(activePage)
				<main class="flex-1 p-6">
					{ children... }
				</main>
			</div>
		</div>
	}
}
