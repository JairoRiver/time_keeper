package layout

templ App(title string, activePage string, authenticated bool, isAnonymous bool) {
	@Base(title) {
		<div class="flex min-h-screen flex-col">
			@Header(authenticated, isAnonymous)
			<div class="flex flex-1">
				@Sidebar(activePage)
				<main class="flex-1 px-6 py-8">
					<div class="mx-auto w-full max-w-5xl animate-in">
						{ children... }
					</div>
				</main>
			</div>
		</div>
	}
}
