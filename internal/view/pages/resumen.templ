package pages

import (
	"fmt"
	"time"
	"github.com/JairoRiver/time_keeper/internal/view/layout"
)

templ Resumen(
	columns []DayColumn,
	dateStart time.Time,
	dateEnd time.Time,
	isAnonymous bool,
) {
	@layout.App("Resumen", "resumen", true, isAnonymous) {
		<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<h1 class="text-2xl font-bold tracking-tight text-slate-900">Resumen</h1>
				<p class="mt-1 text-sm text-slate-500">Visualiza tus bloques de tiempo en el calendario.</p>
			</div>
			@dateRangePicker(dateStart, dateEnd)
		</div>
		@calendarGrid(columns)
	}
}

templ dateRangePicker(dateStart time.Time, dateEnd time.Time) {
	<form method="GET" action="/resumen" class="flex flex-wrap items-end gap-3">
		<label class="flex flex-col gap-1">
			<span class="text-xs font-medium uppercase tracking-wide text-slate-400">Desde</span>
			<input
				type="date"
				name="date_start"
				value={ dateStart.Format("2006-01-02") }
				class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 transition focus:border-indigo-400 focus:outline-none focus:ring-4 focus:ring-indigo-100"
			/>
		</label>
		<label class="flex flex-col gap-1">
			<span class="text-xs font-medium uppercase tracking-wide text-slate-400">Hasta</span>
			<input
				type="date"
				name="date_end"
				value={ dateEnd.Format("2006-01-02") }
				class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 transition focus:border-indigo-400 focus:outline-none focus:ring-4 focus:ring-indigo-100"
			/>
		</label>
		<button
			type="submit"
			class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 px-5 py-2 text-sm font-semibold text-white shadow-sm transition-opacity hover:opacity-90"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4-4"></path></svg>
			Buscar
		</button>
	</form>
}

templ calendarGrid(columns []DayColumn) {
	<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
		if len(columns) == 0 {
			<div class="flex flex-col items-center justify-center gap-2 py-16 text-center">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M8 2v4m8-4v4"></path></svg>
				<p class="text-sm font-medium text-slate-500">Sin entradas en este rango</p>
			</div>
		} else {
			<div class="overflow-auto" style="max-height: 640px;">
				<div class="flex" style="min-width: max-content;">
					<!-- Time axis -->
					<div class="sticky left-0 z-20 flex flex-col bg-white" style="min-width: 4rem;">
						<div class="sticky top-0 z-10 h-10 border-b border-r border-slate-200 bg-white"></div>
						for i := 0; i < 48; i++ {
							<div
								class={ "flex items-start justify-end border-r border-slate-100 pr-2 pt-0.5 text-[11px] font-medium text-slate-400", templ.KV("border-b border-slate-100", i%2 == 1) }
								style={ fmt.Sprintf("height: %dpx;", SlotHeight) }
							>
								if i%2 == 0 {
									{ fmt.Sprintf("%02d:00", i/2) }
								}
							</div>
						}
					</div>
					<!-- Day columns -->
					for _, col := range columns {
						<div class="flex flex-col border-l border-slate-100" style="min-width: 9rem;">
							<div class="sticky top-0 z-10 flex h-10 flex-col items-center justify-center border-b border-slate-200 bg-slate-50/80 backdrop-blur">
								<span class="text-xs font-semibold text-slate-700">{ col.Date.Format("Mon") }</span>
								<span class="text-[11px] text-slate-400">{ col.Label }</span>
							</div>
							<div class="relative" style={ fmt.Sprintf("height: %dpx;", TotalCalendarHeight) }>
								for i := 1; i < 48; i++ {
									<div
										class={ "absolute w-full border-b", templ.KV("border-slate-100", i%2 == 0), templ.KV("border-slate-50", i%2 == 1) }
										style={ fmt.Sprintf("top: %dpx;", i*SlotHeight) }
									></div>
								}
								for _, e := range col.Entries {
									<div
										class="absolute left-1.5 right-1.5 overflow-hidden rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-800 shadow-sm ring-1 ring-inset ring-black/5"
										style={ fmt.Sprintf("top: %dpx; height: %dpx; background-color: %s;", EntryTopPx(e), EntryHeightPx(e), TagHexColor(e.Tag)) }
										title={ e.Tag }
									>
										<p class="truncate leading-tight">{ e.Tag }</p>
										<p class="truncate text-[10px] font-medium opacity-70">{ FormatTime(e.TimeStart) } – { FormatEndShort(e) }</p>
									</div>
								}
							</div>
						</div>
					}
				</div>
			</div>
		}
	</div>
}
